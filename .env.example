# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (used for sitemap & canonical SEO).
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_CODE: Server-side secret access code for the private BN_STONE owner panel.
# Leave empty in preview to use the one-time first-run setup screen, or set before deploying to Vercel.
ADMIN_ACCESS_CODE=

# SUPABASE_URL: Your Supabase project URL (optional locally; recommended for Vercel production).
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase Service Role key (never expose to frontend).
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_STORAGE_BUCKET: Public Supabase Storage bucket name for uploaded product images.
SUPABASE_STORAGE_BUCKET="product-images"
